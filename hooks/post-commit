#!/bin/bash
# Auto: dump database, amend into commit, force-push to remote
#
# Runs after every commit. Always pushes to remote so the repo
# is the single source of truth.
#
# --no-verify on amend prevents infinite recursion.
# --force is safe — this machine is the only writer.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

# 1. Generate fresh DB dump (always, even if it hasn't changed)
mkdir -p db
if ! PGPASSWORD=p4borge55 pg_dump -h localhost -U pwsats -d pwsats_db > db/dump.sql 2>/dev/null; then
    echo "$(date -Iseconds) [post-commit] pg_dump failed" >> /var/log/pwsats-push.log
fi

# 2. Stage + amend (only if dump changed, to avoid pointless rewrite)
git add db/dump.sql 2>/dev/null || true
if ! git diff --cached --quiet db/dump.sql 2>/dev/null; then
    git commit --amend --no-verify -a 2>/dev/null || true
fi

# 3. Always push — this is the only writer
BRANCH=$(git rev-parse --abbrev-ref HEAD)
echo "$(date -Iseconds) [post-commit] pushing branch=$BRANCH sha=$(git rev-parse HEAD)" >> /var/log/pwsats-push.log
git push --force origin "$BRANCH" >> /var/log/pwsats-push.log 2>&1
RESULT=$?
if [ $RESULT -ne 0 ]; then
    echo "$(date -Iseconds) [post-commit] push FAILED with exit $RESULT" >> /var/log/pwsats-push.log
fi
