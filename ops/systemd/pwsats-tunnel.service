[Unit]
Description=Predictions With Sats public app manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/paborgess/Predictions-With-Sats
Environment=PATH=/usr/bin:/bin
ExecStart=/usr/bin/pnpm run start:tunnel
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
