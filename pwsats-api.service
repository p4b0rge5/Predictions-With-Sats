[Unit]
Description=Predictions With Sats - API Server
After=postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/baal-agent/workspace/Predictions-With-Sats
EnvironmentFile=/opt/baal-agent/workspace/Predictions-With-Sats/.env
ExecStart=/root/.nvm/versions/node/v22.22.2/bin/node --enable-source-maps /opt/baal-agent/workspace/Predictions-With-Sats/artifacts/api-server/dist/index.mjs
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pwsats-api

[Install]
WantedBy=multi-user.target
